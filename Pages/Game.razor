    ElementReference gameCanvas;

    Task? pixiInitTask;
    bool pixiReady;

    ScreenState screen = ScreenState.Start;
    bool paused = false;
    bool showHelp = false;
    bool showDiagnostics = false;

    double diagFps;
    double diagAvgFrameMs;
    double diagAvgUpdateMs;
    double diagAvgPixiMs;
    double diagAvgBlazorMs;

    double diagWorstFrameMs;
    double diagWorstUpdateMs;
    double diagWorstPixiMs;
    double diagWorstBlazorMs;

    double diagWindowElapsedMs;
    double diagWindowUpdateMs;
    double diagWindowPixiMs;
    double diagWindowBlazorMs;

    int diagWindowFrames;
    int diagWindowPixiPushes;
    int diagWindowBlazorRenders;

    readonly List<string> diagSpikes = new();

    string diagCopyStatus = "";

    double time, difficulty = 1;
    int score, lives;

    double farmerX = W / 2, farmerTargetX = W / 2;
    double farmerY = H - 130;
    bool keyLeft, keyRight;

    // Wobble
    double wobbleX = W / 2 - 55;
    double wobbleY = H - 75;

    double wobbleFireTimer;
    double wobbleEggTimer;
    double wobbleAnimTimer;
    double wobbleSoundTimer;

    int wobbleFrame;
    int wobbleFollowSide = -1;
    int wobbleRageDirection = 1;

    double wobbleRageMeter;
    double wobbleRageT;

    const double WobbleRageMoveSpeed = 0.72;

    const double WobbleRageDuration = 6000;
    const double WobbleMaxRage = 100;

    const int MaxWobbleShots = 30;

    const double WobbleFollowDistance = 52;
    const double WobbleFollowYOffset = 35;

    const double WobbleNormalFireRate = 700;
    const double WobbleRageFireRate = 150;

    const double WobbleNormalEggRate = 10000;
    const double WobbleRageEggRate = 2400;

    List<WobbleShot> wobbleShots = new();
    List<WobbleEgg> wobbleEggs = new();
    List<WobbleEggBlast> wobbleEggBlasts = new();

    double fireTimer, fireRate = 300;
    double flameSfxTimer;
    double spawnTimer, spawnInterval = 1900;
    double moveSpeed = 0.42;

    double shieldT, rapidT, wideT, flameT, invulnT, hitFlashT;
    bool flashOn;

    List<Bullet> bullets = new();
    List<Bullet> enemyBullets = new();
    List<Enemy> enemies = new();
    List<PowerUp> powerups = new();
    List<CoinPickup> coinPickups = new();
    List<FarmItem> items = new();

    List<BomberBlast> bomberBlasts = new();

    const double BomberBlastRadius = 72;
    const double HarvesterBeamDuration = 2200;

    GameProgress Progress = new();
    int wave = 1, lastWaveTriggered = 1, coinsThisRun = 0;
    int killsSincePowerup;
    bool isNewBest = false;
    const double WaveDurationMs = 25000;

    string toastMsg = "";
    string waveBannerMsg = "";
    string endTitle = "";
    string endMsg = "";

    static readonly (string Id, string Name)[] ItemDefs = new[]
    {
        ("cow", "the cow"),
        ("chicken", "the chicken"),
        ("tractor", "the tractor"),
        ("truck", "the truck"),
        ("corn", "the corn"),
        ("pumpkin", "the pumpkins"),
        ("wife", "HIS WIFE"),
    };

    static readonly Dictionary<string, string> StealLines = new()
    {
        ["cow"] = "Bessie the cow got beamed up! 🐄🛸",
        ["chicken"] = "A chicken just got abducted mid-cluck! 🐔",
        ["tractor"] = "They stole the tractor. Who steals a TRACTOR.",
        ["truck"] = "The truck just flew off... upward.",
        ["corn"] = "The corn is gone. All of it. Every ear.",
        ["pumpkin"] = "Pumpkins: abducted. Ted is fuming.",
        ["wife"] = "THEY TOOK HIS WIFE. THIS IS PERSONAL NOW.",
    };

    static readonly (string Key, string Icon, string Label)[] PowerupDefs = new[]
    {
        ("rapid", "⚡", "Rapid Fire"),
        ("wide", "💥", "Wide Shot"),
        ("shield", "🛡️", "Shield"),
        ("life", "❤️", "+1 Life"),
        ("flame", "🔥", "FLAMETHROWER"),
    };

    List<Explosion> explosions = new();
    List<DecorPlant> decor = new();

    protected override async Task OnInitializedAsync()
    {
        // 1. Initialize the items list first!
        items = ItemDefs.Select(d => new FarmItem { Id = d.Id, Name = d.Name, Safe = true }).ToList();

        // 2. Map explicit X positions
        var xPositions = new Dictionary<string, double>
        {
            ["cow"] = 50,
            ["chicken"] = 110,
            ["tractor"] = 180,
            ["wife"] = 250,
            ["truck"] = 320,
            ["corn"] = 380,
            ["pumpkin"] = 430,
            
        };

        foreach (var item in items)
        {
            if (xPositions.TryGetValue(item.Id, out double customX))
                item.FieldX = customX;
        }

        // 3. Position background decor relative to item positions
        double cornX = items.First(i => i.Id == "corn").FieldX;
        double pumpkinX = items.First(i => i.Id == "pumpkin").FieldX;

        decor.Clear(); // Clear existing entries if restarting
        decor.Add(new() { Image = "images/corn_plant.png", X = cornX - 18, Y = ItemFieldY - 95, W = 22, H = 66 });
        decor.Add(new() { Image = "images/corn_plant.png", X = cornX + 19, Y = ItemFieldY - 88, W = 20, H = 60 });

        decor.Add(new() { Image = "images/pumpkin_plant.png", X = pumpkinX - 19, Y = ItemFieldY - 82, W = 44, H = 42 });
        decor.Add(new() { Image = "images/pumpkin_plant.png", X = pumpkinX + 19, Y = ItemFieldY - 76, W = 40, H = 38 });

        Progress = await GameProgress.LoadAsync(JS);
        _ = PlayMusic("music_intro.mp3");
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            pixiInitTask = InitializePixiAsync();
        }

        return pixiInitTask ?? Task.CompletedTask;
    }

    async Task InitializePixiAsync()
    {
        var itemAssets = ItemDefs.ToDictionary(
            x => x.Id,
            x => Sprites.ForItem(x.Id));

        foreach (var p in PowerupDefs)
        {
            itemAssets[p.Key] = Sprites.ForPower(p.Key);
        }
        itemAssets["coin"] = Sprites.Coin;

        await JS.InvokeVoidAsync(
            "alienFarmPixi.init",
            gameCanvas,
            new
            {
                Width = W,
                Height = H,
                ItemFieldY,
                Assets = new
                {
                    Farmer = Sprites.Farmer,
                    FarmerFlame = Sprites.FarmerFlame,

                    TedBullet = Sprites.TedBullet,
                    TedFlameBurst = Sprites.TedFlameBurst,

                    WobbleStanding = Sprites.WobbleStanding,
                    WobbleLeftLeg = Sprites.WobbleLeftLeg,
                    WobbleRightLeg = Sprites.WobbleRightLeg,

                    WobbleStandingRage = Sprites.WobbleStandingRage,
                    WobbleLeftLegRage = Sprites.WobbleLeftLegRage,
                    WobbleRightLegRage = Sprites.WobbleRightLegRage,

                    WobbleKernel = Sprites.WobbleKernel,
                    WobbleEgg = Sprites.WobbleEgg,
                    WobbleEggExplosion = Sprites.WobbleEggExplosion,

                    UfoFighter = Sprites.UfoFighter,
                    UfoThief = Sprites.UfoThief,
                    UfoElite = Sprites.UfoElite,

                    UfoInterceptor = Sprites.UfoInterceptor,
                    UfoBomber = Sprites.UfoBomber,

                    UfoBossScout = Sprites.UfoBossScout,
                    UfoBossHarvester = Sprites.UfoBossHarvester,
                    UfoBossWar = Sprites.UfoBossWar,

                    InterceptorShot = Sprites.InterceptorShot,
                    BomberBomb = Sprites.BomberBomb,
                    BomberBlast = Sprites.BomberBlast,

                    HarvesterBeamEmitter = Sprites.HarvesterBeamEmitter,

                    WarMothershipShot =Sprites.WarMothershipShot,

                    BeamColumn = Sprites.FxBeamColumn,

                    Items = itemAssets
                }
            });

        pixiReady = true;
        loading = false;
        await InvokeAsync(StateHasChanged);
    }

    const double ItemFieldY = H * 0.72;
    const double BeamHoverY = H * 0.50;
    const double BeamDuration = 1300;

    const int MaxPlayerBullets = 50;
    const int MaxEnemyBullets = 40;
    const int MaxEnemies = 14;
    const int MaxExplosions = 10;

    string Hearts() => lives > 0 ? string.Concat(Enumerable.Repeat("❤️", lives)) : "💀";

    bool IsBeingBeamed(string itemId) =>
        enemies.Any(e =>
            e.State == EnemyState.Beaming &&
            e.TargetItemId == itemId &&
            (
                e.Type == EnemyType.Thief ||
                (
                    e.Type == EnemyType.Boss &&
                    e.BossVariant == BossVariant.Harvester
                )
            ));

    async Task PlayMusic(string file, double volume = 0.5)
    {
        try { await JS.InvokeVoidAsync("gameAudio.playMusic", $"audio/{file}", volume); } catch { }
    }
    async Task PauseMusic() { try { await JS.InvokeVoidAsync("gameAudio.pauseMusic"); } catch { } }
    async Task ResumeMusic() { try { await JS.InvokeVoidAsync("gameAudio.resumeMusic"); } catch { } }
    async Task PlaySfx(string file, double volume = 0.7)
    {
        try { await JS.InvokeVoidAsync("gameAudio.playSfx", $"audio/{file}", volume); } catch { }
    }

    async Task PlayTemporaryMusic(
    string file,
    double volume = 0.7,
    double startAtSeconds = 0)
    {
        try
        {
            await JS.InvokeVoidAsync(
                "gameAudio.playTemporaryMusic",
                $"audio/{file}",
                volume,
                startAtSeconds);
        }
        catch
        {
        }
    }

    async Task StopTemporaryMusic()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "gameAudio.stopTemporaryMusic");
        }
        catch
        {
        }
    }

    static string Px(double v) => v.ToString(CultureInfo.InvariantCulture) + "px";
    static string Num(double v) => v.ToString(CultureInfo.InvariantCulture);

    void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "ArrowLeft" or "a" or "A") keyLeft = true;
        if (e.Key is "ArrowRight" or "d" or "D") keyRight = true;
    }

    void OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key is "ArrowLeft" or "a" or "A") keyLeft = false;
        if (e.Key is "ArrowRight" or "d" or "D") keyRight = false;
    }

    void SetKey(bool left, bool value)
    {
        if (left) keyLeft = value; else keyRight = value;
    }

    async Task StartGame()
    {
        if (pixiInitTask != null)
        {
            await pixiInitTask;
        }

        // Reset game state
        time = 0;
        difficulty = 1;
        score = 0;
        lives = 4 + Progress.LifeLevel;

        ResetDiagnostics();

        farmerX = W / 2;
        farmerTargetX = W / 2;

        await JS.InvokeVoidAsync("alienFarmPixi.resetPlayerInput");

        // Start Wobble slightly behind and to Ted's left
        wobbleFollowSide = -1;
        wobbleRageDirection = 1;

        wobbleX = farmerX - 55;
        wobbleY = farmerY + 35;

        wobbleFireTimer = 300;
        wobbleEggTimer = 5000;
        wobbleAnimTimer = 0;
        wobbleSoundTimer = 5000 + rng.NextDouble() * 5000;

        wobbleFrame = 0;

        wobbleRageMeter = 0;
        wobbleRageT = 0;

        wobbleShots.Clear();
        wobbleEggs.Clear();
        wobbleEggBlasts.Clear();
        bomberBlasts.Clear();

        keyLeft = keyRight = false;

        fireTimer = 0;
        flameSfxTimer = 0;
        fireRate = Math.Max(
            210,
            300 - Progress.FireRateLevel * 18);

        moveSpeed =
            0.42 +
            Progress.SpeedLevel * 0.035;

        spawnTimer = 0;
        spawnInterval = 1900;

        shieldT = 0;
        rapidT = 0;
        wideT = 0;
        flameT = 0;
        invulnT = 0;
        hitFlashT = 0;

        explosions.Clear();

        bullets.Clear();
        enemyBullets.Clear();
        enemies.Clear();
        powerups.Clear();
        coinPickups.Clear();

        foreach (var it in items)
        {
            it.Safe = true;
        }

        toastMsg = "";
        waveBannerMsg = "";

        wave = 1;
        lastWaveTriggered = 1;
        coinsThisRun = 0;
        killsSincePowerup = 0;
        isNewBest = false;

        screen = ScreenState.Playing;

        StateHasChanged();

        _ = PlayMusic(
            rng.Next(2) == 0
                ? "music_gameplay_1.mp3"
                : "music_gameplay_2.mp3");

        await PushPixiFrameAsync();

        loopCts?.Cancel();
        loopCts = new CancellationTokenSource();

        _ = RunLoop(loopCts.Token);

        await Task.Delay(1);
        await stageRef.FocusAsync();
    }

    async Task RunLoop(
    CancellationToken token)
    {
        var clock =
            Stopwatch.StartNew();

        double last =
            clock.Elapsed.TotalMilliseconds;

        double pixiAccumulator = 0;
        double blazorAccumulator = 0;

        const double SimulationFrameMs =
            1000.0 / 60.0;

        const double PixiFrameMs =
            1000.0 / 30.0;

        const double BlazorFrameMs =
            1000.0 / 15.0;

        while (
            !token.IsCancellationRequested &&
            screen == ScreenState.Playing)
        {
            double frameStart =
                clock.Elapsed.TotalMilliseconds;

            double rawFrameMs =
                frameStart - last;

            double dt =
                Math.Min(
                    rawFrameMs,
                    40);

            last = frameStart;

            if (!paused)
            {
                double updateStart =
                    clock.Elapsed.TotalMilliseconds;

                Update(dt);

                double updateMs =
                    clock.Elapsed.TotalMilliseconds -
                    updateStart;

                pixiAccumulator += dt;
                blazorAccumulator += dt;

                double pixiMs = 0;
                bool pixiPushed = false;

                if (pixiAccumulator >= PixiFrameMs)
                {
                    pixiAccumulator %=
                        PixiFrameMs;

                    double pixiStart =
                        clock.Elapsed.TotalMilliseconds;

                    await PushPixiFrameAsync();

                    pixiMs =
                        clock.Elapsed.TotalMilliseconds -
                        pixiStart;

                    pixiPushed = true;
                }

                double blazorMs = 0;
                bool blazorRendered = false;

                if (blazorAccumulator >= BlazorFrameMs)
                {
                    blazorAccumulator %=
                        BlazorFrameMs;

                    double blazorStart =
                        clock.Elapsed.TotalMilliseconds;

                    await InvokeAsync(
                        StateHasChanged);

                    blazorMs =
                        clock.Elapsed.TotalMilliseconds -
                        blazorStart;

                    blazorRendered = true;
                }

                RecordDiagnostics(
                    rawFrameMs,
                    updateMs,
                    pixiMs,
                    pixiPushed,
                    blazorMs,
                    blazorRendered);
            }

            double workTime =
                clock.Elapsed.TotalMilliseconds -
                frameStart;

            int delay =
                (int)Math.Max(
                    1,
                    SimulationFrameMs -
                    workTime);

            try
            {
                await Task.Delay(
                    delay,
                    token);
            }
            catch (OperationCanceledException)
            {
                break;
            }
        }
    }

    void Update(double dt)
    {
        time += dt;

        int currentWave =
            1 + (int)(time / WaveDurationMs);

        double waveProgress =
            (time % WaveDurationMs) /
            WaveDurationMs;

        // Smooth difficulty increase both between
        // and during waves.
        difficulty =
            1.0 +
            (currentWave - 1) * 0.28 +
            waveProgress * 0.28;

        // Enemies arrive progressively faster.
        // Wave 1 still gives the player room to learn.
        spawnInterval =
            Math.Max(
                420,
                1250 -
                (currentWave - 1) * 95 -
                waveProgress * 80);

        if (currentWave > lastWaveTriggered)
        {
            lastWaveTriggered = currentWave;
            wave = currentWave;
            WaveBanner(wave % 5 == 0 ? $"⚠ WAVE {wave} — MOTHERSHIP INBOUND ⚠" : $"WAVE {wave}");
            _ = PlaySfx("sfx_wave_start.wav");
            if (wave % 5 == 0 && !enemies.Any(e => e.Type == EnemyType.Boss))
                SpawnBoss();
        }

        if (shieldT > 0) shieldT -= dt;
        if (rapidT > 0) rapidT -= dt;
        if (wideT > 0) wideT -= dt;
        if (flameT > 0) flameT -= dt;
        if (invulnT > 0) invulnT -= dt;
        if (hitFlashT > 0) hitFlashT -= dt;
        flashOn = ((int)(time / 90)) % 2 == 0;

        if (keyLeft) farmerTargetX -= moveSpeed * dt;
        if (keyRight) farmerTargetX += moveSpeed * dt;
        farmerTargetX = Math.Max(26, Math.Min(W - 26, farmerTargetX));
        farmerX += (farmerTargetX - farmerX) * Math.Min(1, dt / 90);

        fireTimer -= dt;
        if (flameT > 0)
        {
            if (fireTimer <= 0)
            {
                fireTimer = 55;
                if (bullets.Count < MaxPlayerBullets)
                {
                    double fy = farmerY - 38;
                    for (int s = 0; s < 2; s++)
                    {
                        double spread = (rng.NextDouble() - 0.5) * 0.32;
                        bullets.Add(new Bullet { X = farmerX, Y = fy, Vx = spread, Vy = -0.44 - rng.NextDouble() * 0.08, IsFlame = true });
                    }
                }
                flameSfxTimer -= 55;
                if (flameSfxTimer <= 0)
                {
                    flameSfxTimer = 180;
                    _ = PlaySfx("sfx_bullet.mp3", 0.22);
                }
            }
        }
        else
        {
            double rate = rapidT > 0 ? fireRate * 0.45 : fireRate;
            if (fireTimer <= 0)
            {
                fireTimer = rate;
                if (bullets.Count < MaxPlayerBullets)
                {
                    double fy = farmerY - 38;
                    if (wideT > 0)
                    {
                        bullets.Add(new Bullet { X = farmerX, Y = fy, Vx = 0, Vy = -0.42 });
                        bullets.Add(new Bullet { X = farmerX, Y = fy, Vx = -0.14, Vy = -0.4 });
                        bullets.Add(new Bullet { X = farmerX, Y = fy, Vx = 0.14, Vy = -0.4 });
                    }
                    else
                    {
                        bullets.Add(new Bullet { X = farmerX, Y = fy, Vx = 0, Vy = -0.46 });
                    }
                    _ = PlaySfx("sfx_bullet.mp3", 0.35);
                }
            }
        }

        foreach (var b in bullets) { b.X += b.Vx * dt; b.Y += b.Vy * dt; }
        bullets.RemoveAll(b => b.Y < -20);

        for (int i = enemyBullets.Count - 1; i >= 0; i--)
        {
            var b = enemyBullets[i];

            b.X += b.Vx * dt;
            b.Y += b.Vy * dt;

            // Bomber bombs explode when they reach Ted's combat row.
            if (b.EnemyKind ==
                    EnemyProjectileKind.BomberBomb &&
                b.Y >= farmerY - 15)
            {
                enemyBullets.RemoveAt(i);

                SpawnBomberBlast(
                    b.X,
                    b.Y);

                continue;
            }

            if (b.Y > H + 30 ||
                b.X < -40 ||
                b.X > W + 40)
            {
                enemyBullets.RemoveAt(i);
            }
        }

        spawnTimer -= dt;

        if (spawnTimer <= 0)
        {
            spawnTimer = spawnInterval;

            int spawnCount = 1;

            // The invasion becomes denser as waves increase.
            if (wave >= 3 &&
                rng.NextDouble() < 0.35)
            {
                spawnCount++;
            }

            if (wave >= 6 &&
                rng.NextDouble() < 0.40)
            {
                spawnCount++;
            }

            if (wave >= 10 &&
                rng.NextDouble() < 0.30)
            {
                spawnCount++;
            }

            for (int i = 0;
                 i < spawnCount;
                 i++)
            {
                SpawnEnemy();
            }
        }

        foreach (var en in enemies)
        {
            en.Phase += dt * 0.0022 * en.Wobble;

            if (en.Type == EnemyType.Fighter || en.Type == EnemyType.Elite)
            {
                en.X += Math.Sin(en.Phase) * en.VxBase * dt / 1000 * 0.6;
                en.X = Math.Max(20, Math.Min(W - 20, en.X));

                switch (en.State)
                {
                    case EnemyState.Descending:
                        en.Y += en.Vy * dt / 1000;
                        if (en.Y >= en.PatrolY)
                        {
                            en.Y = en.PatrolY;
                            en.State = EnemyState.Hovering;
                        }
                        break;
                    case EnemyState.Hovering:
                        en.Y = en.PatrolY + Math.Sin(en.Phase * 1.6) * 4;
                        en.HoverTimer -= dt;
                        en.ShootTimer -= dt;
                        if (en.ShootTimer <= 0)
                        {
                            en.ShootTimer = (en.Type == EnemyType.Elite ? 1100 : 1600) + rng.NextDouble() * 900;
                            if (enemyBullets.Count < MaxEnemyBullets)
                                enemyBullets.Add(new Bullet { X = en.X, Y = en.Y + 14, Vx = (farmerX - en.X) * 0.0007, Vy = 0.17 });
                        }
                        if (en.HoverTimer <= 0)
                        {
                            en.State = EnemyState.Fleeing;
                            en.Vy = -Math.Abs(en.Vy) * 1.4;
                        }
                        break;
                    case EnemyState.Fleeing:
                        en.Y += en.Vy * dt / 1000;
                        break;
                }
            }
            else if (en.Type == EnemyType.Interceptor)
            {
                UpdateInterceptor(en, dt);
            }
            else if (en.Type == EnemyType.Bomber)
            {
                UpdateBomber(en, dt);
            }
            else if (en.Type == EnemyType.Boss)
            {
                UpdateBoss(en, dt);
            }
            else
            {
                if (en.State == EnemyState.Descending)
                {
                    en.X += (en.TargetFieldX - en.X) * Math.Min(1, dt / 700);
                    en.X += Math.Sin(en.Phase) * 6 * dt / 1000;
                    en.X = Math.Max(20, Math.Min(W - 20, en.X));

                    en.Y += en.Vy * dt / 1000;
                    if (en.Y >= en.PatrolY)
                    {
                        en.Y = en.PatrolY;
                        en.State = EnemyState.Beaming;
                        en.BeamElapsed = 0;

                        AddWobbleRage(8);

                        _ = PlaySfx("sfx_beam_deploy.wav");
                    }
                }
                else if (en.State == EnemyState.Beaming)
                {
                    en.X += (en.TargetFieldX - en.X) * Math.Min(1, dt / 400);
                    en.Y = en.PatrolY + Math.Sin(en.Phase * 1.4) * 3;
                    en.BeamElapsed += dt;
                    if (en.BeamElapsed >= BeamDuration)
                    {
                        StealTargetItem(en);
                        en.State = EnemyState.Fleeing;
                        en.Vy = -Math.Abs(en.Vy) * 1.6;
                    }
                }
                else
                {
                    en.X += Math.Sin(en.Phase) * en.VxBase * dt / 1000 * 0.6;
                    en.X = Math.Max(20, Math.Min(W - 20, en.X));
                    en.Y += en.Vy * dt / 1000;
                }
            }
        }
        enemies.RemoveAll(en => en.Y < -80 || en.Y > H + 40);

        UpdateWobble(dt);

        foreach (var p in powerups) p.Y += p.Vy * dt / 1000;
        powerups.RemoveAll(p => p.Y > H + 30);

        foreach (var c in coinPickups) c.Y += c.Vy * dt / 1000;
        coinPickups.RemoveAll(c => c.Y > H + 30);

        foreach (var ex in explosions) ex.Age += dt;
        explosions.RemoveAll(ex => ex.Age >= Explosion.Lifetime);

        foreach (var blast in bomberBlasts)
        {
            blast.Age += dt;
        }

        bomberBlasts.RemoveAll(
            blast =>
                blast.Age >=
                BomberBlast.Lifetime);

        for (int bi = bullets.Count - 1; bi >= 0; bi--)
        {
            var b = bullets[bi];
            for (int ei = enemies.Count - 1; ei >= 0; ei--)
            {
                var en = enemies[ei];
                double hitR = GetEnemyHitRadius(en); 
                double dx = b.X - en.X, dy = b.Y - en.Y;
                if (dx * dx + dy * dy < hitR * hitR)
                {
                    bullets.RemoveAt(bi);

                    DamageEnemy(
                        ei,
                        1,
                        fromWobble: false);

                    break;
                }
            }
        }

        // collisions: coins vs farmer
        for (int i = coinPickups.Count - 1; i >= 0; i--)
        {
            var c = coinPickups[i];
            double dx = c.X - farmerX, dy = c.Y - farmerY;
            if (dx * dx + dy * dy < 42 * 42)
            {
                coinPickups.RemoveAt(i);
                coinsThisRun += c.Value;
                _ = PlaySfx("sfx_coin.wav");
            }
        }

        // collisions: enemy bullets vs farmer
        for (int i = enemyBullets.Count - 1; i >= 0; i--)
        {
            var b =
                enemyBullets[i];

            // Bombs hurt through their explosion,
            // not through direct collision.
            if (b.EnemyKind ==
                EnemyProjectileKind.BomberBomb)
            {
                continue;
            }

            double dx =
                b.X - farmerX;

            double dy =
                b.Y - farmerY;

            double hitRadius =
                b.EnemyKind ==
                    EnemyProjectileKind.WarMothership
                        ? 32
                        : 20;

            if (dx * dx + dy * dy <
                hitRadius * hitRadius)
            {
                enemyBullets.RemoveAt(i);

                Hurt();
            }
        }

        // collisions: enemy body vs farmer
        for (int i = enemies.Count - 1; i >= 0; i--)
        {
            var en = enemies[i];
            double dx = en.X - farmerX;

            double dy =
                en.Y - farmerY;

            double hitRadius =
                GetEnemyHitRadius(en) + 20;

            if (dx * dx + dy * dy <
                hitRadius * hitRadius)
            {
                enemies.RemoveAt(i);
                Hurt();
            }
        }

        // collisions: powerups vs farmer
        for (int i = powerups.Count - 1; i >= 0; i--)
        {
            var p = powerups[i];
            double dx = p.X - farmerX, dy = p.Y - farmerY;
            if (dx * dx + dy * dy < 42 * 42)
            {
                powerups.RemoveAt(i);
                ApplyPowerup(p);
            }
        }
    }

    void UpdateInterceptor(Enemy en, double dt)
    {
        en.X +=
            Math.Sin(en.Phase * 2.4) *
            en.VxBase *
            dt /
            1000 *
            1.7;

        en.X =
            Math.Clamp(
                en.X,
                35,
                W - 35);

        if (en.State ==
            EnemyState.Descending)
        {
            en.Y +=
                en.Vy *
                dt /
                1000;

            if (en.Y >= en.PatrolY)
            {
                en.Y = en.PatrolY;
                en.State =
                    EnemyState.Hovering;
            }

            return;
        }

        if (en.State ==
            EnemyState.Hovering)
        {
            en.Y =
                en.PatrolY +
                Math.Sin(
                    en.Phase * 2.8) *
                9;

            en.ShootTimer -= dt;
            en.HoverTimer -= dt;

            if (en.ShootTimer <= 0)
            {
                en.ShootTimer =
                    650 +
                    rng.NextDouble() *
                    450;

                if (enemyBullets.Count <
                    MaxEnemyBullets)
                {
                    double dx =
                        farmerX -
                        en.X;

                    enemyBullets.Add(
                        new Bullet
                        {
                            X = en.X,
                            Y = en.Y + 20,

                            Vx =
                                dx *
                                0.001,

                            Vy = 0.32,

                            EnemyKind =
                                EnemyProjectileKind
                                    .Interceptor
                        });
                }
            }

            if (en.HoverTimer <= 0)
            {
                en.State =
                    EnemyState.Fleeing;

                en.Vy =
                    -Math.Abs(en.Vy) *
                    1.8;
            }

            return;
        }

        en.Y +=
            en.Vy *
            dt /
            1000;
    }

    void UpdateBomber(Enemy en, double dt)
    {
        en.X +=
            Math.Sin(en.Phase * 0.8) *
            en.VxBase *
            dt /
            1000 *
            0.45;

        en.X =
            Math.Clamp(
                en.X,
                45,
                W - 45);

        if (en.State ==
            EnemyState.Descending)
        {
            en.Y +=
                en.Vy *
                dt /
                1000;

            if (en.Y >= en.PatrolY)
            {
                en.Y = en.PatrolY;
                en.State =
                    EnemyState.Hovering;
            }

            return;
        }

        if (en.State ==
            EnemyState.Hovering)
        {
            en.Y =
                en.PatrolY +
                Math.Sin(en.Phase) * 4;

            en.ShootTimer -= dt;
            en.HoverTimer -= dt;

            if (en.ShootTimer <= 0)
            {
                en.ShootTimer =
                    1800 +
                    rng.NextDouble() *
                    750;

                if (enemyBullets.Count <
                    MaxEnemyBullets)
                {
                    // Bomb aims roughly where Ted
                    // was when it was released.
                    enemyBullets.Add(
                        new Bullet
                        {
                            X = en.X,
                            Y = en.Y + 25,

                            Vx =
                                (farmerX - en.X) *
                                0.00012,

                            Vy = 0.17,

                            EnemyKind =
                                EnemyProjectileKind
                                    .BomberBomb
                        });
                }
            }

            if (en.HoverTimer <= 0)
            {
                en.State =
                    EnemyState.Fleeing;

                en.Vy =
                    -Math.Abs(en.Vy);
            }

            return;
        }

        en.Y +=
            en.Vy *
            dt /
            1000;
    }

    void UpdateBoss(Enemy en, double dt)
    {
        en.X +=
            Math.Sin(en.Phase * 0.7) *
            14 *
            dt /
            1000;

        en.X =
            Math.Clamp(
                en.X,
                90,
                W - 90);

        if (en.State ==
            EnemyState.Descending)
        {
            en.Y +=
                en.Vy *
                dt /
                1000;

            if (en.Y >= en.PatrolY)
            {
                en.Y = en.PatrolY;
                en.State =
                    EnemyState.Hovering;
            }

            return;
        }

        en.Y =
            en.PatrolY +
            Math.Sin(
                en.Phase * 1.2) *
            6;

        switch (en.BossVariant)
        {
            case BossVariant.Harvester:
                UpdateHarvesterBoss(
                    en,
                    dt);
                break;

            case BossVariant.War:
                UpdateWarBoss(
                    en,
                    dt);
                break;

            default:
                UpdateScoutBoss(
                    en,
                    dt);
                break;
        }
    }

    void UpdateScoutBoss(Enemy en, double dt)
    {
        en.ShootTimer -= dt;

        if (en.ShootTimer > 0)
            return;

        en.ShootTimer =
            1300 +
            rng.NextDouble() * 400;

        if (enemyBullets.Count >=
            MaxEnemyBullets)
            return;

        for (int s = -1;
             s <= 1;
             s++)
        {
            enemyBullets.Add(
                new Bullet
                {
                    X = en.X,
                    Y = en.Y + 35,

                    Vx =
                        s * 0.10 +
                        (farmerX - en.X) *
                        0.0004,

                    Vy = 0.19,

                    EnemyKind =
                        EnemyProjectileKind.Standard
                });
        }
    }

    void UpdateWarBoss(Enemy en, double dt)
    {
        en.ShootTimer -= dt;

        if (en.ShootTimer > 0)
            return;

        en.ShootTimer =
            900 +
            rng.NextDouble() * 350;

        if (enemyBullets.Count >=
            MaxEnemyBullets)
            return;

        enemyBullets.Add(
            new Bullet
            {
                X = en.X,
                Y = en.Y + 40,

                Vx =
                    (farmerX - en.X) *
                    0.00038,

                Vy = 0.18,

                EnemyKind =
                    EnemyProjectileKind
                        .WarMothership
            });
    }

    void UpdateHarvesterBoss(Enemy en, double dt)
    {
        if (en.State == EnemyState.Beaming)
        {
            en.X +=
                (en.TargetFieldX - en.X) *
                Math.Min(
                    1,
                    dt / 300);

            en.BeamElapsed += dt;

            if (en.BeamElapsed >= HarvesterBeamDuration)
            {
                StealTargetItem(en);

                // The farm item stays stolen,
                // but the boss is not physically
                // carrying it like a Thief does.
                en.StolenItemId = null;
                en.TargetItemId = null;

                en.State =
                    EnemyState.Hovering;

                en.ShootTimer =
                    2200 +
                    rng.NextDouble() *
                    1100;
            }

            return;
        }

        if (en.TargetItemId != null)
        {
            en.X +=
                (en.TargetFieldX - en.X) *
                Math.Min(
                    1,
                    dt / 400);

            if (Math.Abs(
                    en.X -
                    en.TargetFieldX) < 8)
            {
                en.State =
                    EnemyState.Beaming;

                en.BeamElapsed = 0;

                AddWobbleRage(12);

                _ = PlaySfx(
                    "sfx_beam_deploy.wav");
            }

            return;
        }

        en.ShootTimer -= dt;

        if (en.ShootTimer > 0)
            return;

        // Don't let the Harvester target an item
        // already being pursued by another Thief
        // or another Harvester.
        var alreadyTargeted =
            enemies
                .Where(e =>
                    e != en &&
                    e.TargetItemId != null &&
                    e.State != EnemyState.Fleeing &&
                    (
                        e.Type == EnemyType.Thief ||
                        (
                            e.Type == EnemyType.Boss &&
                            e.BossVariant ==
                                BossVariant.Harvester
                        )
                    ))
                .Select(e => e.TargetItemId!)
                .ToHashSet();

        var targets =
            items
                .Where(i =>
                    i.Safe &&
                    !alreadyTargeted.Contains(i.Id))
                .ToList();

        if (targets.Count == 0)
            return;

        var target =
            targets[
                rng.Next(
                    targets.Count)];

        en.TargetItemId =
            target.Id;

        en.TargetFieldX =
            target.FieldX;
    }

    void UpdateWobble(double dt)
    {
        bool raging = wobbleRageT > 0;

        // ---------------------------------
        // Rage timer
        // ---------------------------------
        if (wobbleRageT > 0)
        {
            wobbleRageT -= dt;

            if (wobbleRageT <= 0)
            {
                wobbleRageT = 0;
                wobbleRageMeter = 0;

                _ = StopTemporaryMusic();
            }
            else
            {
                wobbleRageMeter =
                    WobbleMaxRage *
                    (wobbleRageT / WobbleRageDuration);
            }
        }

        raging = wobbleRageT > 0;

        // ---------------------------------
        // Movement
        // ---------------------------------

        double previousX = wobbleX;

        if (raging)
        {
            // Wobble has lost his mind.
            // Ignore Ted and sprint independently across the screen.
            wobbleX +=
                wobbleRageDirection *
                WobbleRageMoveSpeed *
                dt;

            // Bounce off the edges.
            if (wobbleX <= 30)
            {
                wobbleX = 30;
                wobbleRageDirection = 1;
            }
            else if (wobbleX >= W - 30)
            {
                wobbleX = W - 30;
                wobbleRageDirection = -1;
            }

            // Keep him around the same combat row,
            // but give him a little frantic bob.
            double rageY =
                farmerY +
                WobbleFollowYOffset +
                Math.Sin(time / 55.0) * 6;

            wobbleY +=
                (rageY - wobbleY) *
                Math.Min(1, dt / 70);
        }
        else
        {
            // Normal behavior: trail behind Ted.
            double tedMovement =
                farmerTargetX - farmerX;

            if (tedMovement > 2)
            {
                wobbleFollowSide = -1;
            }
            else if (tedMovement < -2)
            {
                wobbleFollowSide = 1;
            }

            if (farmerX < 70)
                wobbleFollowSide = 1;

            if (farmerX > W - 70)
                wobbleFollowSide = -1;

            double desiredX =
                farmerX +
                wobbleFollowSide *
                WobbleFollowDistance;

            desiredX =
                Math.Clamp(
                    desiredX,
                    28,
                    W - 28);

            double desiredY =
                farmerY +
                WobbleFollowYOffset;

            wobbleX +=
                (desiredX - wobbleX) *
                Math.Min(1, dt / 180);

            wobbleY +=
                (desiredY - wobbleY) *
                Math.Min(1, dt / 180);
        }

        // ---------------------------------
        // Walking animation
        // ---------------------------------

        bool moving =
            Math.Abs(wobbleX - previousX) > 0.08;

        if (moving)
        {
            wobbleAnimTimer += dt;

            double animationRate =
                raging ? 65 : 120;

            int phase =
                ((int)(wobbleAnimTimer / animationRate)) % 4;

            wobbleFrame = phase switch
            {
                1 => 1, // left leg
                3 => 2, // right leg
                _ => 0  // standing
            };
        }
        else
        {
            wobbleAnimTimer = 0;
            wobbleFrame = 0;
        }

        // ---------------------------------
        // Find target
        // ---------------------------------

        Enemy? target =
            GetWobbleTarget();

        wobbleFireTimer -= dt;
        wobbleEggTimer -= dt;

        wobbleSoundTimer -= dt;

        if (!raging &&
            wobbleSoundTimer <= 0)
        {
            _ = PlaySfx(
                "sfx_wobble.mp3",
                0.55);

            // Anywhere from 8–18 seconds before
            // he randomly speaks again.
            wobbleSoundTimer =
                8000 +
                rng.NextDouble() * 10000;
        }

        // ---------------------------------
        // Kernel gun
        // ---------------------------------

        if (target != null &&
            wobbleFireTimer <= 0 &&
            wobbleShots.Count < MaxWobbleShots)
        {
            wobbleFireTimer =
                raging
                    ? WobbleRageFireRate
                    : WobbleNormalFireRate;

            FireWobbleKernel(target);
        }

        // ---------------------------------
        // Eggstrike
        // ---------------------------------

        if (target != null &&
            wobbleEggTimer <= 0)
        {
            // Don't waste eggs on a single normal fighter.
            bool worthEgg =
                target.Type != EnemyType.Fighter ||
                enemies.Count >= 3;

            if (worthEgg)
            {
                LaunchWobbleEgg(target);

                wobbleEggTimer =
                    raging
                        ? WobbleRageEggRate
                        : WobbleNormalEggRate;
            }
        }

        // ---------------------------------
        // Move kernels
        // ---------------------------------

        foreach (var shot in wobbleShots)
        {
            shot.X += shot.Vx * dt;
            shot.Y += shot.Vy * dt;
        }

        wobbleShots.RemoveAll(s =>
            s.X < -30 ||
            s.X > W + 30 ||
            s.Y < -30 ||
            s.Y > H + 30);

        // ---------------------------------
        // Kernel collisions
        // ---------------------------------

        for (int shotIndex = wobbleShots.Count - 1;
             shotIndex >= 0;
             shotIndex--)
        {
            var shot = wobbleShots[shotIndex];

            for (int enemyIndex = enemies.Count - 1;
                 enemyIndex >= 0;
                 enemyIndex--)
            {
                var enemy = enemies[enemyIndex];

                double hitRadius = GetEnemyHitRadius(enemy);

                double dx =
                    shot.X - enemy.X;

                double dy =
                    shot.Y - enemy.Y;

                if (dx * dx + dy * dy <
                    hitRadius * hitRadius)
                {
                    wobbleShots.RemoveAt(shotIndex);

                    DamageEnemy(
                        enemyIndex,
                        shot.Damage,
                        fromWobble: true);

                    break;
                }
            }
        }

        // ---------------------------------
        // Move eggs
        // ---------------------------------

        for (int i = wobbleEggs.Count - 1;
             i >= 0;
             i--)
        {
            var egg = wobbleEggs[i];

            egg.X += egg.Vx * dt;
            egg.Y += egg.Vy * dt;

            egg.Rotation += dt * 0.012;
            egg.Age += dt;

            bool hitEnemy =
                enemies.Any(enemy =>
                {
                    double enemyRadius = GetEnemyHitRadius(enemy);

                    double dx =
                        enemy.X - egg.X;

                    double dy =
                        enemy.Y - egg.Y;

                    double radius =
                        enemyRadius + 10;

                    return dx * dx + dy * dy <
                           radius * radius;
                });

            bool expired =
                egg.Age >= 1800 ||
                egg.X < -40 ||
                egg.X > W + 40 ||
                egg.Y < -40 ||
                egg.Y > H + 40;

            if (hitEnemy || expired)
            {
                wobbleEggs.RemoveAt(i);

                ExplodeWobbleEgg(
                    egg.X,
                    egg.Y,
                    egg.Damage);
            }
        }

        // ---------------------------------
        // Explosion animation lifetime
        // ---------------------------------

        foreach (var blast in wobbleEggBlasts)
        {
            blast.Age += dt;
        }

        wobbleEggBlasts.RemoveAll(
            blast =>
                blast.Age >=
                WobbleEggBlast.Lifetime);
    }

    void FireWobbleKernel(Enemy target)
    {
        double startX = wobbleX;

        // Approximate height of his weapon.
        double startY = wobbleY - 50;

        double dx =
            target.X - startX;

        double dy =
            target.Y - startY;

        double distance =
            Math.Sqrt(
                dx * dx +
                dy * dy);

        if (distance <= 0.001)
            return;

        bool raging =
            wobbleRageT > 0;

        double speed =
            raging
                ? 0.60
                : 0.48;

        wobbleShots.Add(
            new WobbleShot
            {
                X = startX,
                Y = startY,

                Vx = dx / distance * speed,
                Vy = dy / distance * speed,

                Damage =
                    raging
                        ? 2
                        : 1
            });
    }

    void LaunchWobbleEgg(Enemy target)
    {
        double startX = wobbleX;
        double startY = wobbleY - 42;

        double dx =
            target.X - startX;

        double dy =
            target.Y - startY;

        double distance =
            Math.Sqrt(
                dx * dx +
                dy * dy);

        if (distance <= 0.001)
            return;

        const double speed = 0.40;

        wobbleEggs.Add(
            new WobbleEgg
            {
                X = startX,
                Y = startY,

                Vx = dx / distance * speed,
                Vy = dy / distance * speed,

                Damage =
                    wobbleRageT > 0
                        ? 4
                        : 2
            });
    }

    void ExplodeWobbleEgg(
    double x,
    double y,
    int damage)
    {
        wobbleEggBlasts.Add(
            new WobbleEggBlast
            {
                X = x,
                Y = y
            });

        _ = PlaySfx(
            rng.Next(2) == 0
                ? "sfx_explosion_1.wav"
                : "sfx_explosion_2.wav",
            0.7);

        const double blastRadius = 60;

        double blastRadiusSquared =
            blastRadius * blastRadius;

        // Walk backwards because DamageEnemy()
        // is allowed to remove enemies.
        for (int i = enemies.Count - 1;
             i >= 0;
             i--)
        {
            var enemy =
                enemies[i];

            double dx =
                enemy.X - x;

            double dy =
                enemy.Y - y;

            if (dx * dx + dy * dy <=
                blastRadiusSquared)
            {
                DamageEnemy(
                    i,
                    damage,
                    fromWobble: true);
            }
        }
    }

    void DamageEnemy(int enemyIndex, int damage, bool fromWobble)
    {
        if (enemyIndex < 0 ||
            enemyIndex >= enemies.Count)
            return;

        var enemy =
            enemies[enemyIndex];

        enemy.Hp -= damage;

        // ---------------------------------
        // Wobble-specific effects
        // ---------------------------------

        if (fromWobble)
        {
            AddWobbleRage(
                damage * 1.5);

            // His specialty:
            // make alien abductions take longer.
            bool isAbducting = enemy.State == EnemyState.Beaming &&
            (
                enemy.Type ==
                    EnemyType.Thief ||
                (
                    enemy.Type ==
                        EnemyType.Boss &&
                    enemy.BossVariant ==
                        BossVariant.Harvester
                )
            );

            if (isAbducting)
            {
                double beamPushback =
                    wobbleRageT > 0
                        ? 220
                        : 110;

                enemy.BeamElapsed =
                    Math.Max(
                        0,
                        enemy.BeamElapsed -
                        beamPushback);
            }
        }

        if (enemy.Hp > 0)
            return;

        // ---------------------------------
        // Enemy died
        // ---------------------------------

        enemies.RemoveAt(enemyIndex);

        if (enemy.Type == EnemyType.Thief &&
            enemy.StolenItemId != null)
        {
            var rescued =
                items.FirstOrDefault(
                    item =>
                        item.Id ==
                        enemy.StolenItemId);

            if (rescued != null)
            {
                rescued.Safe = true;

                Toast(
                    fromWobble
                        ? $"Wobble rescued {rescued.Name}! 🦃"
                        : $"Rescued {rescued.Name}! 🎉");
            }
        }

        switch (enemy.Type)
        {
            case EnemyType.Thief:

                score += 16;

                DropCoinMaybe(
                    enemy.X,
                    enemy.Y,
                    0.25,
                    1);

                SpawnExplosion(
                    enemy.X,
                    enemy.Y,
                    ExplosionSize.Small);

                AddWobbleRage(5);

                break;

            case EnemyType.Interceptor:

                score += 18;

                DropCoinMaybe(
                    enemy.X,
                    enemy.Y,
                    0.25,
                    1);

                SpawnExplosion(
                    enemy.X,
                    enemy.Y,
                    ExplosionSize.Small);

                AddWobbleRage(3);

                break;

            case EnemyType.Bomber:

                score += 30;

                DropCoinMaybe(
                    enemy.X,
                    enemy.Y,
                    0.5,
                    2);

                SpawnExplosion(
                    enemy.X,
                    enemy.Y,
                    ExplosionSize.Medium);

                AddWobbleRage(5);

                break;

            case EnemyType.Elite:

                score += 25;

                DropCoinMaybe(
                    enemy.X,
                    enemy.Y,
                    1.0,
                    2);

                SpawnExplosion(
                    enemy.X,
                    enemy.Y,
                    ExplosionSize.Medium);

                AddWobbleRage(4);

                break;

            case EnemyType.Boss:

                score += 150;

                DropCoinMaybe(
                    enemy.X,
                    enemy.Y,
                    1.0,
                    12);

                WaveBanner(
                    "👽 MOTHERSHIP DESTROYED! 👽");

                SpawnExplosion(
                    enemy.X,
                    enemy.Y,
                    ExplosionSize.Large);

                AddWobbleRage(15);

                break;

            default:

                score += 10;

                DropCoinMaybe(
                    enemy.X,
                    enemy.Y,
                    0.15,
                    1);

                SpawnExplosion(
                    enemy.X,
                    enemy.Y,
                    ExplosionSize.Small);

                AddWobbleRage(2);

                break;
        }

        DropPowerupMaybe(
            enemy.X,
            enemy.Y);
    }

    Enemy? GetWobbleTarget()
    {
        return enemies
            .Where(e =>
                e.State != EnemyState.Fleeing ||
                (e.Type == EnemyType.Thief && e.StolenItemId != null))
            .OrderBy(WobbleTargetPriority)
            .ThenBy(e =>
            {
                double dx = e.X - wobbleX;
                double dy = e.Y - wobbleY;

                return dx * dx + dy * dy;
            })
            .FirstOrDefault();
    }

    int WobbleTargetPriority(Enemy enemy)
    {
        // Somebody is actively stealing the farm.
        if (enemy.Type == EnemyType.Thief &&
            enemy.State == EnemyState.Beaming)
            return 0;

        // A thief already has something. Get it back.
        if (enemy.Type == EnemyType.Thief &&
            enemy.StolenItemId != null)
            return 1;

        // Stop thieves before they reach the farm.
        if (enemy.Type == EnemyType.Thief)
            return 2;

        if (enemy.Type == EnemyType.Bomber)
            return 3;

        if (enemy.Type == EnemyType.Interceptor)
            return 4;

        if (enemy.Type == EnemyType.Elite)
            return 5;

        if (enemy.Type == EnemyType.Boss)
            return 6;

        return 7;
    }

    void AddWobbleRage(double amount)
    {
        if (wobbleRageT > 0)
            return;

        wobbleRageMeter = Math.Min(
            WobbleMaxRage,
            wobbleRageMeter + amount);

        if (wobbleRageMeter < WobbleMaxRage)
            return;

        wobbleRageMeter = WobbleMaxRage;
        wobbleRageT = WobbleRageDuration;

        wobbleFireTimer = 0;

        // Let him throw an egg almost immediately.
        wobbleEggTimer = Math.Min(
            wobbleEggTimer,
            500);

        WaveBanner("🦃 WOBBLE HAS HAD ENOUGH 🦃");

        _ = PlayTemporaryMusic(
            "sfx_wobble_rage.mp3",
            0.75,
            2.0);
    }

    void SpawnEnemy()
    {
        if (enemies.Count >= MaxEnemies)
            return;

        var alreadyTargeted = enemies
        .Where(e =>
            e.TargetItemId != null &&
            e.State != EnemyState.Fleeing &&
            (
                e.Type == EnemyType.Thief ||
                (
                    e.Type == EnemyType.Boss &&
                    e.BossVariant ==
                        BossVariant.Harvester
                )
            ))
        .Select(e => e.TargetItemId!)
        .ToHashSet();

        var availableTargets =
            items
                .Where(i =>
                    i.Safe &&
                    !alreadyTargeted.Contains(i.Id))
                .ToList();

        double thiefChance =
            availableTargets.Count > 0
                ? Math.Min(
                    0.32,
                    0.12 +
                    (wave - 1) * 0.025)
                : 0;

        double interceptorChance =
            wave >= 3
                ? Math.Min(
                    0.22,
                    0.07 +
                    (wave - 3) * 0.02)
                : 0;

        double bomberChance =
            wave >= 4
                ? Math.Min(
                    0.18,
                    0.05 +
                    (wave - 4) * 0.018)
                : 0;

        double eliteChance =
            wave >= 3
                ? Math.Min(
                    0.25,
                    0.06 +
                    (wave - 3) * 0.025)
                : 0;

        double roll = rng.NextDouble();

        EnemyType type;

        if (roll < thiefChance)
        {
            type = EnemyType.Thief;
        }
        else
        {
            roll -= thiefChance;

            if (roll < interceptorChance)
            {
                type = EnemyType.Interceptor;
            }
            else
            {
                roll -= interceptorChance;

                if (roll < bomberChance)
                {
                    type = EnemyType.Bomber;
                }
                else
                {
                    roll -= bomberChance;

                    type =
                        roll < eliteChance
                            ? EnemyType.Elite
                            : EnemyType.Fighter;
                }
            }
        }

        int hp =
            type switch
            {
                EnemyType.Interceptor =>
                    Math.Min(
                        3 + wave / 3,
                        9),

                EnemyType.Bomber =>
                    Math.Min(
                        8 + wave,
                        20),

                EnemyType.Elite =>
                    Math.Min(
                        8 + wave,
                        22),

                EnemyType.Thief =>
                    Math.Min(
                        5 + wave / 2,
                        14),

                EnemyType.Fighter =>
                    Math.Min(
                        3 + wave / 2,
                        12),

                _ => 3
            };

        double baseSpeed =
            type switch
            {
                EnemyType.Interceptor => 135,
                EnemyType.Bomber => 78,
                EnemyType.Thief => 92,
                EnemyType.Elite => 105,
                EnemyType.Fighter => 88,
                _ => 88
            };

        double patrolY =
            type switch
            {
                EnemyType.Thief =>
                    BeamHoverY,

                EnemyType.Interceptor =>
                    H *
                    (0.23 +
                     rng.NextDouble() * 0.12),

                EnemyType.Bomber =>
                    H *
                    (0.27 +
                     rng.NextDouble() * 0.10),

                _ =>
                    H *
                    (0.30 +
                     rng.NextDouble() * 0.18)
            };

        var en =
            new Enemy
            {
                X =
                    40 +
                    rng.NextDouble() *
                    (W - 80),

                Y = -45,

                Vy =
                    baseSpeed *
                    (0.9 +
                     rng.NextDouble() * 0.5) *
                    (1 +
                     difficulty * 0.06),

                VxBase =
                    (rng.NextDouble() < 0.5
                        ? -1
                        : 1) *
                    (20 +
                     rng.NextDouble() * 24),

                Phase =
                    rng.NextDouble() *
                    Math.PI * 2,

                Hp = hp,
                MaxHp = hp,

                Type = type,

                ShootTimer =
                    600 +
                    rng.NextDouble() * 800,

                StealZoneY =
                    ItemFieldY,

                Wobble =
                    rng.NextDouble() * 2 + 1,

                PatrolY =
                    patrolY,

                HoverTimer =
                    type switch
                    {
                        EnemyType.Interceptor =>
                            3000 +
                            rng.NextDouble() * 1500,

                        EnemyType.Bomber =>
                            5000 +
                            rng.NextDouble() * 1800,

                        _ =>
                            4000 +
                            rng.NextDouble() * 2500
                    }
            };

        if (type == EnemyType.Thief)
        {
            var target =
                availableTargets[
                    rng.Next(
                        availableTargets.Count)];

            en.TargetItemId =
                target.Id;

            en.TargetFieldX =
                target.FieldX;
        }

        enemies.Add(en);
    }

    void SpawnBoss()
    {
        int bossNumber =
            Math.Max(
                1,
                wave / 5);

        BossVariant variant =
            (BossVariant)(
                (bossNumber - 1) % 3);

        int hp =
            20 +
            wave * 4;

        hp +=
            variant switch
            {
                BossVariant.Harvester => 8,
                BossVariant.War => 14,
                _ => 0
            };

        enemies.Add(
            new Enemy
            {
                X = W / 2,
                Y = -90,

                Vy = 42,

                Phase = 0,

                Hp = hp,
                MaxHp = hp,

                Type =
                    EnemyType.Boss,

                BossVariant =
                    variant,

                ShootTimer =
                    variant switch
                    {
                        BossVariant.Harvester =>
                            1800,

                        BossVariant.War =>
                            1100,

                        _ =>
                            1500
                    },

                PatrolY =
                    H * 0.22,

                Wobble = 1
            });
    }

    void DropPowerupMaybe(
    double x,
    double y)
    {
        killsSincePowerup++;

        // Starts restrained but increases as the
        // game becomes more dangerous.
        double chance =
            0.12 +
            (wave - 1) * 0.025 +
            Progress.PowerupLevel * 0.03;

        chance =
            Math.Min(
                chance,
                0.38);

        // Prevent extremely unlucky dry streaks.
        bool guaranteedDrop =
            killsSincePowerup >= 7;

        if (!guaranteedDrop &&
            rng.NextDouble() >= chance)
        {
            return;
        }

        killsSincePowerup = 0;

        // Control which powerups appear by stage
        // and make the strongest ones less common.
        string[] weightedKeys =
            wave switch
            {
                1 => new[]
                {
                "rapid", "rapid",
                "wide", "wide",
                "shield", "shield"
                },

                2 => new[]
                {
                "rapid", "rapid",
                "wide", "wide",
                "shield", "shield",
                "life"
                },

                _ => new[]
                {
                "rapid", "rapid",
                "wide", "wide",
                "shield", "shield",
                "life",
                "flame"
                }
            };

        string key =
            weightedKeys[
                rng.Next(weightedKeys.Length)];

        var def =
            PowerupDefs.First(p =>
                p.Key == key);

        powerups.Add(
            new PowerUp
            {
                X = x,
                Y = y,
                Vy = 60,
                Key = def.Key,
                Icon = def.Icon,
                Label = def.Label
            });
    }

    void DropCoinMaybe(double x, double y, double chance, int value)
    {
        if (rng.NextDouble() < chance)
            coinPickups.Add(new CoinPickup { X = x, Y = y, Vy = 55, Value = value });
    }

    void SpawnExplosion(double x, double y, ExplosionSize size)
    {
        if (explosions.Count >= MaxExplosions) return;
        explosions.Add(new Explosion { X = x, Y = y, Size = size });
        _ = PlaySfx(rng.Next(2) == 0 ? "sfx_explosion_1.wav" : "sfx_explosion_2.wav", size == ExplosionSize.Large ? 0.9 : 0.6);
    }

    void SpawnBomberBlast(double x, double y)
    {
        bomberBlasts.Add(
            new BomberBlast
            {
                X = x,
                Y = y
            });

        double dx =
            farmerX - x;

        double dy =
            farmerY - y;

        double radiusSquared =
            BomberBlastRadius *
            BomberBlastRadius;

        if (dx * dx + dy * dy <=
            radiusSquared)
        {
            Hurt();
        }

        _ = PlaySfx(
            rng.Next(2) == 0
                ? "sfx_explosion_1.wav"
                : "sfx_explosion_2.wav",
            0.8);
    }

    void StealTargetItem(Enemy en)
    {
        var target = items.FirstOrDefault(i => i.Id == en.TargetItemId && i.Safe);
        if (target == null)
        {
            var fallback = items.Where(i => i.Safe).ToList();
            if (fallback.Count == 0) return;
            target = fallback[rng.Next(fallback.Count)];
        }
        target.Safe = false;
        en.StolenItemId = target.Id;
        Toast(StealLines.TryGetValue(target.Id, out var line) ? line : $"They stole {target.Name}!");
        if (items.All(i => !i.Safe)) EndGame(items: true);
    }

    void Hurt()
    {
        if (invulnT > 0 || shieldT > 0) return;
        lives -= 1;
        AddWobbleRage(12);
        invulnT = 1300;
        hitFlashT = 220;
        _ = PlaySfx("sfx_hit.wav");
        if (lives <= 0) EndGame(items: false);
    }

    void ApplyPowerup(PowerUp p)
    {
        switch (p.Key)
        {
            case "rapid": rapidT = 6000; break;
            case "wide": wideT = 7000; break;
            case "shield": shieldT = 5000; break;
            case "life": lives = Math.Min(lives + 1, 5); break;
            case "flame": flameT = 6500; break;
        }
        Toast($"{p.Icon} {p.Label}!");
        _ = PlaySfx("sfx_powerup.wav");
    }

    void Toast(string msg)
    {
        toastMsg = msg;
        toastCts?.Cancel();
        toastCts = new CancellationTokenSource();
        var token = toastCts.Token;
        _ = Task.Delay(1600, token).ContinueWith(t =>
        {
            if (!t.IsCanceled)
            {
                toastMsg = "";
                _ = InvokeAsync(StateHasChanged);
            }
        }, TaskScheduler.Default);
    }

    CancellationTokenSource? bannerCts;
    void WaveBanner(string msg)
    {
        waveBannerMsg = msg;
        bannerCts?.Cancel();
        bannerCts = new CancellationTokenSource();
        var token = bannerCts.Token;
        _ = Task.Delay(2200, token).ContinueWith(t =>
        {
            if (!t.IsCanceled)
            {
                waveBannerMsg = "";
                _ = InvokeAsync(StateHasChanged);
            }
        }, TaskScheduler.Default);
    }

    void EndGame(bool items)
    {
        screen = ScreenState.End;
        loopCts?.Cancel();
        _ = PlayMusic("music_lose.mp3");
        if (items)
        {
            endTitle = "THE FARM IS GONE 👽";
            endMsg = "Every last thing got beamed into space — including his wife. Ted is currently filing a very strange police report.";
        }
        else
        {
            endTitle = "GAME OVER";
            int remaining = this.items.Count(i => i.Safe);
            endMsg = remaining == ItemDefs.Length
                ? "You went down swinging, but at least the farm's still intact. Barely."
                : $"You held onto {remaining} of {ItemDefs.Length} things before the aliens got you. Ted appreciates the effort.";
        }

        isNewBest = score > Progress.BestScore;
        if (isNewBest) Progress.BestScore = score;
        Progress.TotalCoins += coinsThisRun;
        _ = Progress.SaveAsync(JS);
    }

    async Task TogglePause()
    {
        paused = !paused;
        if (paused) await PauseMusic(); else await ResumeMusic();
    }

    void ToggleDiagnostics()
    {
        showDiagnostics = !showDiagnostics;
        diagCopyStatus = "";
    }

    void ResetDiagnostics()
    {
        diagFps = 0;

        diagAvgFrameMs = 0;
        diagAvgUpdateMs = 0;
        diagAvgPixiMs = 0;
        diagAvgBlazorMs = 0;

        diagWorstFrameMs = 0;
        diagWorstUpdateMs = 0;
        diagWorstPixiMs = 0;
        diagWorstBlazorMs = 0;

        diagWindowElapsedMs = 0;
        diagWindowUpdateMs = 0;
        diagWindowPixiMs = 0;
        diagWindowBlazorMs = 0;

        diagWindowFrames = 0;
        diagWindowPixiPushes = 0;
        diagWindowBlazorRenders = 0;

        diagSpikes.Clear();
        diagCopyStatus = "";
    }

    void RecordDiagnostics(
        double frameMs,
        double updateMs,
        double pixiMs,
        bool pixiPushed,
        double blazorMs,
        bool blazorRendered)
    {
        diagWindowElapsedMs += frameMs;
        diagWindowUpdateMs += updateMs;
        diagWindowFrames++;

        if (pixiPushed)
        {
            diagWindowPixiMs += pixiMs;
            diagWindowPixiPushes++;
        }

        if (blazorRendered)
        {
            diagWindowBlazorMs += blazorMs;
            diagWindowBlazorRenders++;
        }

        diagWorstFrameMs =
            Math.Max(
                diagWorstFrameMs,
                frameMs);

        diagWorstUpdateMs =
            Math.Max(
                diagWorstUpdateMs,
                updateMs);

        if (pixiPushed)
        {
            diagWorstPixiMs =
                Math.Max(
                    diagWorstPixiMs,
                    pixiMs);
        }

        if (blazorRendered)
        {
            diagWorstBlazorMs =
                Math.Max(
                    diagWorstBlazorMs,
                    blazorMs);
        }

        bool spike =
            frameMs >= 40 ||
            updateMs >= 12 ||
            (pixiPushed && pixiMs >= 18) ||
            (blazorRendered && blazorMs >= 12);

        if (spike)
        {
            string entry =
                $"{time / 1000.0:0.0}s " +
                $"W{wave} | " +
                $"Frame {frameMs:0.0}ms | " +
                $"Update {updateMs:0.0}ms | " +
                $"Pixi {pixiMs:0.0}ms | " +
                $"UI {blazorMs:0.0}ms | " +
                $"E:{enemies.Count} " +
                $"P:{bullets.Count + wobbleShots.Count + wobbleEggs.Count} " +
                $"A:{enemyBullets.Count}";

            diagSpikes.Insert(
                0,
                entry);

            if (diagSpikes.Count > 8)
            {
                diagSpikes.RemoveAt(
                    diagSpikes.Count - 1);
            }
        }

        if (diagWindowElapsedMs >= 1000)
        {
            diagFps =
                diagWindowFrames *
                1000.0 /
                diagWindowElapsedMs;

            diagAvgFrameMs =
                diagWindowElapsedMs /
                Math.Max(
                    1,
                    diagWindowFrames);

            diagAvgUpdateMs =
                diagWindowUpdateMs /
                Math.Max(
                    1,
                    diagWindowFrames);

            diagAvgPixiMs =
                diagWindowPixiPushes > 0
                    ? diagWindowPixiMs /
                      diagWindowPixiPushes
                    : 0;

            diagAvgBlazorMs =
                diagWindowBlazorRenders > 0
                    ? diagWindowBlazorMs /
                      diagWindowBlazorRenders
                    : 0;

            diagWindowElapsedMs = 0;
            diagWindowUpdateMs = 0;
            diagWindowPixiMs = 0;
            diagWindowBlazorMs = 0;

            diagWindowFrames = 0;
            diagWindowPixiPushes = 0;
            diagWindowBlazorRenders = 0;
        }
    }

    string BuildDiagnosticsReport()
    {
        return string.Join(
            Environment.NewLine,
            new[]
            {
            "ALIEN FARM HEIST DIAGNOSTICS",
            $"Wave: {wave}",
            $"Score: {score}",
            "",
            $"FPS: {diagFps:0.0}",
            $"Frame Avg: {diagAvgFrameMs:0.00} ms",
            $"Frame Worst: {diagWorstFrameMs:0.00} ms",
            $"Update Avg: {diagAvgUpdateMs:0.00} ms",
            $"Update Worst: {diagWorstUpdateMs:0.00} ms",
            $"Pixi Avg: {diagAvgPixiMs:0.00} ms",
            $"Pixi Worst: {diagWorstPixiMs:0.00} ms",
            $"Blazor Avg: {diagAvgBlazorMs:0.00} ms",
            $"Blazor Worst: {diagWorstBlazorMs:0.00} ms",
            "",
            $"Enemies: {enemies.Count}",
            $"Ted Shots: {bullets.Count}",
            $"Wobble Shots: {wobbleShots.Count + wobbleEggs.Count}",
            $"Enemy Shots: {enemyBullets.Count}",
            $"Effects: {explosions.Count + bomberBlasts.Count + wobbleEggBlasts.Count}",
            $"Coins: {coinPickups.Count}",
            $"Powerups: {powerups.Count}",
            "",
            "RECENT SPIKES",
            diagSpikes.Count == 0
                ? "None"
                : string.Join(
                    Environment.NewLine,
                    diagSpikes)
            });
    }

    async Task CopyDiagnosticsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "navigator.clipboard.writeText",
                BuildDiagnosticsReport());

            diagCopyStatus =
                "Diagnostics copied.";
        }
        catch
        {
            diagCopyStatus =
                "Clipboard unavailable on this browser.";
        }
    }

    async Task QuitToMenu()
    {
        loopCts?.Cancel();
        paused = false;
        Progress.TotalCoins += coinsThisRun;
        await Progress.SaveAsync(JS);
        screen = ScreenState.Start;
        await PlayMusic("music_intro.mp3");
    }

    async Task GoToShop()
    {
        screen = ScreenState.Shop;
        await PlayMusic("music_shop.mp3");
    }

    async Task BackToStart()
    {
        screen = ScreenState.Start;
        await PlayMusic("music_intro.mp3");
    }

    async Task BuyUpgrade(string key)
    {
        int level = Progress.LevelFor(key);
        if (level >= GameProgress.MaxLevel) return;
        int cost = GameProgress.CostFor(key, level);
        if (Progress.TotalCoins < cost) return;
        Progress.TotalCoins -= cost;
        Progress.SetLevel(key, level + 1);
        await Progress.SaveAsync(JS);
    }

    public void Dispose()
    {
        loopCts?.Cancel();
        toastCts?.Cancel();
        bannerCts?.Cancel();
    }

    async ValueTask PushPixiFrameAsync()
    {
        if (!pixiReady)
            return;

        var frame = new
        {
            Farmer = new
            {
                X = (float)farmerX,
                Y = (float)farmerY,
                Flame = flameT > 0,
                Flash = invulnT > 0 && flashOn
            },

            Wobble = new
            {
                X = (float)wobbleX,
                Y = (float)wobbleY,
                Frame = wobbleFrame,
                Rage = wobbleRageT > 0
            },

            WobbleShots = wobbleShots
                .SelectMany(s => new float[]
                {
                s.Id.GetHashCode(),
                (float)s.X,
                (float)s.Y
                })
                .ToArray(),

            WobbleEggs = wobbleEggs
                .SelectMany(e => new float[]
                {
                e.Id.GetHashCode(),
                (float)e.X,
                (float)e.Y,
                (float)e.Rotation
                })
                .ToArray(),

            WobbleEggBlasts = wobbleEggBlasts
                .SelectMany(e => new float[]
                {
                e.Id.GetHashCode(),
                (float)e.X,
                (float)e.Y,
                (float)Math.Min(
                    1,
                    e.Age / WobbleEggBlast.Lifetime)
                })
                .ToArray(),

            // Ted projectiles
            // [id, x, y, projectileKind]
            // 0 = normal bullet
            // 1 = flame burst
            Bullets = bullets
                .SelectMany(b => new float[]
                {
                b.Id.GetHashCode(),
                (float)b.X,
                (float)b.Y,
                b.IsFlame ? 1f : 0f
                })
                .ToArray(),

            // Alien projectiles
            // [id, x, y, projectileKind, rotation]
            EnemyBullets = enemyBullets
                .SelectMany(b => new float[]
                {
                b.Id.GetHashCode(),
                (float)b.X,
                (float)b.Y,
                (float)b.EnemyKind,
                (float)Math.Atan2(
                    b.Vy,
                    b.Vx)
                })
                .ToArray(),

            Enemies = enemies
                .Select(en => new
                {
                    Id = en.Id.GetHashCode(),

                    X = (float)en.X,
                    Y = (float)en.Y,

                    en.Hp,
                    en.MaxHp,

                    Type = (float)en.Type,

                    BossVariant =
                        (float)en.BossVariant,

                    // Regular Thief beam.
                    IsBeaming =
                        en.Type == EnemyType.Thief &&
                        en.State == EnemyState.Beaming,

                    // Special Harvester mothership beam.
                    IsHarvesterBeaming =
                        en.Type == EnemyType.Boss &&
                        en.BossVariant == BossVariant.Harvester &&
                        en.State == EnemyState.Beaming,

                    TargetItemId =
                        en.TargetItemId,

                    BeamProgress =
                        en.State == EnemyState.Beaming
                            ? (float)Math.Min(
                                1,
                                en.BeamElapsed /
                                (
                                    en.Type == EnemyType.Boss &&
                                    en.BossVariant == BossVariant.Harvester
                                        ? HarvesterBeamDuration
                                        : BeamDuration
                                ))
                            : 0f
                })
                .ToArray(),

            // Only render farm items that are safe
            // and aren't currently being pulled into a beam.
            Items = items
                .Where(i =>
                    i.Safe &&
                    !IsBeingBeamed(i.Id))
                .Select(i => new
                {
                    i.Id,
                    X = (float)i.FieldX,
                    Y = (float)ItemFieldY
                })
                .ToArray(),

            Powerups = powerups
                .Select(p => new
                {
                    Id = p.Id.GetHashCode(),
                    p.Key,
                    X = (float)p.X,
                    Y = (float)p.Y
                })
                .ToArray(),

            Coins = coinPickups
                .SelectMany(c => new float[]
                {
                c.Id.GetHashCode(),
                (float)c.X,
                (float)c.Y
                })
                .ToArray(),

            Explosions = explosions
                .SelectMany(ex => new float[]
                {
                ex.Id.GetHashCode(),
                (float)ex.X,
                (float)ex.Y,
                (float)ex.Size,
                (float)Math.Min(
                    1,
                    ex.Age / Explosion.Lifetime)
                })
                .ToArray(),

            // Bomber AoE explosion animation
            // [id, x, y, progress]
            BomberBlasts = bomberBlasts
                .SelectMany(b => new float[]
                {
                b.Id.GetHashCode(),
                (float)b.X,
                (float)b.Y,
                (float)Math.Min(
                    1,
                    b.Age / BomberBlast.Lifetime)
                })
                .ToArray()
        };

        double pointerTargetX = await JS.InvokeAsync<double>("alienFarmPixi.sync", frame);

        if (pointerTargetX >= 0 &&
            screen == ScreenState.Playing &&
            !paused)
        {
            farmerTargetX =
                Math.Clamp(
                    pointerTargetX,
                    24,
                    W - 24);

            // Pointer control takes over from keyboard control,
            // matching the previous behavior.
            keyLeft = false;
            keyRight = false;
        }
    }

    double GetEnemyHitRadius( Enemy enemy)
    {
        return enemy.Type switch
        {
            EnemyType.Boss => 80,
            EnemyType.Bomber => 40,
            EnemyType.Interceptor => 32,
            _ => 36
        };
    }
